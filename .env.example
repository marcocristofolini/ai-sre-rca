DEMO_MODE=true
LOG_LEVEL=INFO
DATABASE_URL=

# Operational productization
AUTH_ENABLED=false
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHMS=RS256,ES256
OIDC_ROLES_CLAIM=roles
OIDC_TENANT_CLAIM=tenant
OIDC_CLUSTERS_CLAIM=clusters
DEFAULT_TENANT_ID=default
VIEWER_ROLE=viewer
INVESTIGATOR_ROLE=investigator
ADMIN_ROLE=admin
REMEDIATOR_ROLE=remediator

# Alertmanager uses a machine token instead of interactive OIDC.
ALERTMANAGER_WEBHOOK_TOKEN=
ALERTMANAGER_TENANT_ID=default

NOTIFICATIONS_ENABLED=false
NOTIFICATION_MIN_SEVERITY=warning
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
PAGERDUTY_EVENTS_URL=https://events.pagerduty.com/v2/enqueue

INCIDENT_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90

QUERY_BUDGET_ENABLED=true
QUERY_BUDGET_MAX_CALLS=80
QUERY_BUDGET_MAX_CALLS_PER_SOURCE=30
QUERY_BUDGET_MAX_WALL_SECONDS=45

# v0.8 Persistent Awareness Graph
AWARENESS_STALE_AFTER_MINUTES=1440
# Graph Health treats the latest authoritative snapshot as stale after this age.
AWARENESS_INVENTORY_MAX_AGE_MINUTES=15
# Retention keeps inventory snapshot receipts indefinitely and always preserves
# the latest observation for every entity/relationship target.
AWARENESS_OBSERVATION_RETENTION_DAYS=90
AWARENESS_TOMBSTONE_RETENTION_DAYS=30
# Scope used only by the optional scheduled retention worker.
AWARENESS_RETENTION_TENANT_ID=default
AWARENESS_RETENTION_CLUSTERS=
AWARENESS_AUTHORITATIVE_INVENTORY_SOURCES=kubernetes
# Automatic Kubernetes inventory worker. A non-empty cluster list is required.
AWARENESS_INVENTORY_TENANT_ID=default
AWARENESS_INVENTORY_CLUSTERS=
# Empty namespaces means cluster-wide inventory.
AWARENESS_INVENTORY_NAMESPACES=
AWARENESS_INVENTORY_KINDS=Service,Deployment,StatefulSet,DaemonSet,ReplicaSet,Pod,Node
AWARENESS_INVENTORY_PAGE_SIZE=500
AWARENESS_MAX_TRAVERSAL_DEPTH=4
AWARENESS_MAX_TRAVERSAL_NODES=200
AWARENESS_MAX_TRAVERSAL_EDGES=800

# v0.8 bounded agentic investigation. Planning is available by default.
# Parallel specialist execution is experimental, read-only and opt-in.
AGENTIC_PLANNER_ENABLED=true
AGENTIC_EXECUTION_ENABLED=false
# Optional advisory LLM branch selector. Requires LLM_ENABLED=true.
# The model can only suggest specialist names; the server recompiles tasks,
# dependencies and budgets from deterministic templates.
AGENTIC_MODEL_PLANNER_ENABLED=false
AGENTIC_MODEL_PLANNER_TIMEOUT_SECONDS=10
AGENTIC_MODEL_PLANNER_MAX_SPECIALISTS=6
AGENTIC_MAX_TASKS=6
AGENTIC_MAX_PARALLEL_TASKS=4
AGENTIC_MAX_CONTEXT_NODES=50
AGENTIC_CONTEXT_DEPTH=3
AGENTIC_CONTEXT_MAX_HISTORY_TARGETS=12
AGENTIC_CONTEXT_HISTORY_PER_TARGET=2
AGENTIC_CONTEXT_CHANGE_LIMIT=20
AGENTIC_SPECIALIST_MAX_QUERIES=12
AGENTIC_KUBERNETES_MAX_QUERIES=30

# JSON object keyed by logical cluster name. Example:
# {"prod-us":{"kubernetes_api_url":"https://...","prometheus_url":"http://...","loki_url":"http://...","tempo_url":"http://..."}}
CLUSTER_CONFIG_JSON={}

# Guarded remediation plane. Run app.remediation.main:app as a separate
# service/ServiceAccount. Keep this disabled in the investigator process.
REMEDIATION_ENABLED=false
REMEDIATION_REQUIRE_DISTINCT_APPROVER=true
REMEDIATION_PLAN_TTL_MINUTES=30
REMEDIATION_MAX_INCIDENT_AGE_MINUTES=120
REMEDIATION_ALLOWED_ACTIONS=scale_deployment
REMEDIATION_ALLOWED_NAMESPACES=
# Exact confirmed playbook hypothesis IDs allowed to justify scaling.
# Empty is fail-closed.
REMEDIATION_SCALE_HYPOTHESIS_ALLOWLIST=
REMEDIATION_MIN_REPLICAS=1
REMEDIATION_MAX_REPLICAS=20
REMEDIATION_MAX_REPLICA_DELTA=3
# Separate credential registry from CLUSTER_CONFIG_JSON. For an in-cluster
# remediator using its own ServiceAccount token: {"prod-us":{}}
REMEDIATION_CLUSTER_CONFIG_JSON={}


KUBERNETES_API_URL=https://kubernetes.default.svc
KUBERNETES_TOKEN_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token
KUBERNETES_CA_FILE=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt

PROMETHEUS_URL=http://prometheus-operated.monitoring.svc:9090
LOKI_URL=http://loki-gateway.logging.svc:3100
TEMPO_URL=http://tempo-query-frontend.tracing.svc:3200
TEMPO_TENANT_ID=
TRACE_ANALYSIS_ENABLED=true
TRACE_WINDOW_MINUTES=15
TRACE_SEARCH_LIMIT=8
TRACE_FETCH_LIMIT=4
TRACE_SLOW_SPAN_MIN_MS=500
TRACE_SLOW_SPAN_ROOT_FRACTION=0.5

STATEFUL_DEPENDENCY_ANALYSIS_ENABLED=true
STATEFUL_DEPENDENCY_MAX_TARGETS=4
DEPENDENCY_WINDOW_MINUTES=15

POSTGRES_CONNECTION_UTILIZATION_CRITICAL=0.90
POSTGRES_LOCKS_CRITICAL=50
POSTGRES_ACCESS_EXCLUSIVE_LOCKS_CRITICAL=1
POSTGRES_DEADLOCKS_DELTA_CRITICAL=1
POSTGRES_REPLICATION_LAG_BYTES_CRITICAL=16777216
POSTGRES_LONG_TX_SECONDS_CRITICAL=60

KAFKA_CONSUMER_LAG_CRITICAL=10000
KAFKA_UNDER_REPLICATED_PARTITIONS_CRITICAL=1
KAFKA_OFFLINE_PARTITIONS_CRITICAL=1
KAFKA_CONSUMER_GROUP_MEMBERS_MIN=1

REDIS_MEMORY_UTILIZATION_CRITICAL=0.90
REDIS_EVICTIONS_DELTA_CRITICAL=1
REDIS_BLOCKED_CLIENTS_CRITICAL=1
REDIS_CLIENT_UTILIZATION_CRITICAL=0.90
REDIS_COMMAND_LATENCY_SECONDS_CRITICAL=0.05

ARGOCD_URL=http://argocd-server.argocd.svc
ARGOCD_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=
CHANGE_CORRELATION_WINDOW_MINUTES=180
SERVICE_GRAPH_WINDOW_MINUTES=15

# Optional. The model can propose hypotheses and advisory specialist priorities only.
# It cannot confirm root cause, create executable tasks or call infrastructure tools.
LLM_ENABLED=false
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=local-model
LLM_MAX_HYPOTHESES=4

CORS_ORIGINS=http://localhost:3000
