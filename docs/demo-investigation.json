  "root_cause": {
    "title": "Ephemeral-storage exhaustion caused kubelet eviction",
    "summary": "Kubelet evicted the pod while the node reported DiskPressure, and Kubernetes explicitly identified ephemeral-storage as the scarce resource. The workload had no ephemeral-storage request/limit, which is recorded as a contributing scheduling/accounting risk rather than the direct eviction trigger. Change correlation and Karpenter lifecycle evidence are evaluated separately so temporal coincidence cannot override the direct Kubernetes signal.",
    "hypothesis_id": "disk-pressure",
    "evidence_strength": "strong",
    "supporting_signals": 4,
    "contradicting_signals": 0
  },
  "remediation": [
    {
      "priority": "P1",
      "action": "Define ephemeral-storage requests and limits for the affected workload after measuring normal and burst usage.",
      "reason": "Prevents unbounded local-storage consumption and improves scheduler accounting.",
      "requires_approval": true
    },
    {
      "priority": "P1",
      "action": "Alert on node filesystem availability and DiskPressure before kubelet eviction thresholds are reached.",
      "reason": "Provides lead time before workload eviction.",
      "requires_approval": true
    },
    {
      "priority": "P2",
      "action": "Identify high ephemeral-storage consumers on the node and validate log/cache/temp-file retention.",
      "reason": "Finds the workload or host path producing the storage pressure.",
      "requires_approval": true
    },
    {
      "priority": "P2",
      "action": "Review kubelet eviction thresholds and node root-volume sizing against observed production usage.",
      "reason": "Validates capacity and safety margins without masking runaway disk usage.",
      "requires_approval": true
    },
