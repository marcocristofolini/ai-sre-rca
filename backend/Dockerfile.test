# syntax=docker/dockerfile:1
FROM python:3.15-slim

WORKDIR /app

COPY pyproject.toml ./
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install ".[dev]"
COPY app ./app
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --no-deps .
COPY tests ./tests

CMD ["python", "-m", "pytest", "-q"]
